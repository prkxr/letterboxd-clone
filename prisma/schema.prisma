generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // NO urls go here anymore!
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  email         String         @unique
  password_hash String
  ratings       Rating[]
  journals      JournalEntry[]
  lists         List[]
}

model Movie {
  id          String         @id @default(cuid())
  tmdb_id     Int            @unique
  title       String
  year        Int
  poster_url  String?
  ratings     Rating[]
  journals    JournalEntry[]
  list_movies ListMovie[]
}

model Rating {
  id           String   @id @default(cuid())
  rating       Float
  watched_date DateTime @default(now())
  user_id      String
  movie_id     String
  user         User     @relation(fields: [user_id], references: [id])
  movie        Movie    @relation(fields: [movie_id], references: [id])
}

model JournalEntry {
  id           String   @id @default(cuid())
  entry_text   String   @db.Text
  watched_date DateTime @default(now())
  user_id      String
  movie_id     String
  user         User     @relation(fields: [user_id], references: [id])
  movie        Movie    @relation(fields: [movie_id], references: [id])
}

model List {
  id          String      @id @default(cuid())
  list_name   String
  description String?     @db.Text
  user_id     String
  user        User        @relation(fields: [user_id], references: [id])
  movies      ListMovie[]
}

model ListMovie {
  id       String @id @default(cuid())
  position Int
  list_id  String
  movie_id String
  list     List   @relation(fields: [list_id], references: [id], onDelete: Cascade)
  movie    Movie  @relation(fields: [movie_id], references: [id])

  @@unique([list_id, movie_id])
}